{
  "name": "fairshakeinsignia",
  "version": "1.0.3",
  "description": "A rendering of FAIR assessment scores from FAIRshake",
  "publishConfig": {
    "public": true
  },
  "main": "src/index.js",
  "scripts": {
    "do-prepare": "node bin/get-schema.js > src/schema.js",
    "build:browser": "esbuild src/index.js --target=chrome58,firefox57,safari11,edge18 --bundle --minify --outfile=dist/browser.min.js",
    "build:node": "esbuild src/index.js --platform=node --bundle --minify --outfile=dist/index.js",
    "build": "npm-run-all build:*",
    "do-prepublish": "npm run do-prepare && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaayanLab/FAIRshake.git"
  },
  "keywords": [
    "FAIR",
    "insignia",
    "fairshake"
  ],
  "author": "Daniel J. B. Clarke",
  "license": "CC BY-NC-SA 4.0",
  "bugs": {
    "url": "https://github.com/MaayanLab/FAIRshake/issues"
  },
  "homepage": "https://github.com/MaayanLab/FAIRshake#readme",
  "dependencies": {
    "atob": "^2.1.2",
    "axios": "^1.13.2",
    "coreapi": "^0.0.3",
    "d3": "^7.9.0",
    "tippy.js": "^6.3.7",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.28.6",
    "@babel/node": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "browserify": "^17.0.1",
    "esbuild": "0.27.2",
    "npm-run-all": "^4.1.5"
  },
  "browserify": {
    "standalone": "insignia"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}
